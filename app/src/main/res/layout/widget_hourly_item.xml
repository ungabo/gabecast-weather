<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_hour_time"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="2 PM"
        android:textColor="#F8FFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_hour_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Forecast"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_weather_partly_cloudy" />

    <TextView
        android:id="@+id/widget_hour_temp"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false"
        android:text="--"
        android:textColor="#F8FFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_hour_precip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Precipitation"
            android:src="@drawable/ic_metric_precip" />

        <TextView
            android:id="@+id/widget_hour_precip"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="--"
            android:textColor="#BCE9EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_hour_wind_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="Wind"
            android:src="@drawable/ic_metric_wind" />

        <TextView
            android:id="@+id/widget_hour_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="--"
            android:textColor="#BCE9EC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
